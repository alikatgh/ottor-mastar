{
  "name": "ottor_mastar",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/gen-sitemap.cjs && node scripts/gen-catalog-json.cjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint src scripts",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "optimize": "node scripts/optimize-images.cjs && node scripts/optimize-illustrations.cjs && node scripts/gen-illustration-manifest.cjs",
    "optimize:illustrations": "node scripts/optimize-illustrations.cjs && node scripts/gen-illustration-manifest.cjs",
    "optimize:mongolia": "node scripts/optimize-mongolia.cjs",
    "optimize:all": "node scripts/optimize-images.cjs && node scripts/optimize-illustrations.cjs && node scripts/optimize-mongolia.cjs && node scripts/gen-illustration-manifest.cjs",
    "data:sitemap": "node scripts/gen-sitemap.cjs",
    "data:catalog": "node scripts/gen-catalog-json.cjs",
    "data:export": "node scripts/export-native-data.cjs"
  },
  "dependencies": {
    "framer-motion": "^12.42.2",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^1.23.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^7.18.1",
    "react-zoom-pan-pinch": "^4.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.1"
  }
}
