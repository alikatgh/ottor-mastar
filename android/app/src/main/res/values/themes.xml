<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this only styles the window before the
         first frame (cream, no action bar) so launch doesn't flash white. -->
    <style name="Theme.OttorMastar" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cream</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
