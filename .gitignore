# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Large source photos — unused at runtime (only optimized /plants/*.webp ship)
_src_originals/whatsapp/
_src_originals/mongolia/

# Native apps — generated artifacts.
# Bundled data/images regenerate with: node scripts/export-native-data.cjs
shared/
# Ignore the exported data (direct children) but KEEP source assets under
# Resources/ tracked (app icon catalog + privacy manifest).
ios/OttorMastar/Resources/*
!ios/OttorMastar/Resources/Assets.xcassets
!ios/OttorMastar/Resources/PrivacyInfo.xcprivacy
android/app/src/main/assets/
# Xcode project is generated from ios/project.yml with: cd ios && xcodegen
ios/OttorMastar.xcodeproj/
ios/OttorMastar/Info.plist

# Built app binaries
builds/
# Xcode derived data from CLI builds (xcodebuild -derivedDataPath build)
ios/build/
